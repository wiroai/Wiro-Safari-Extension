{
  "manifest_version": 3,
  "name": "Wiro AI",
  "short_name": "Wiro",
  "version": "0.1.2",
  "description": "Right-click an image, video, audio clip or text to run Wiro AI models: animate, edit, upscale, voice and more.",
  "homepage_url": "https://wiro.ai",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Wiro",
    "default_popup": "panel.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": {
    "scripts": ["background.js"],
    "persistent": false
  },
  "content_scripts": [
    {
      "matches": ["https://wiro.ai/extension/callback*"],
      "js": ["callback.js"],
      "run_at": "document_idle"
    }
  ],
  "permissions": ["contextMenus", "storage"],
  "host_permissions": ["<all_urls>"],
  "browser_specific_settings": {
    "safari": {
      "strict_min_version": "16.4"
    }
  }
}
